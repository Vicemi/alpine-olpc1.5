# XO-1.5 overrides applied on top of Alpine's linux-lts x86 config.
# Format: CONFIG_X=y|m|n  (applied with scripts/config, then olddefconfig).

# --- CPU: VIA C7, no PAE (C7 cannot boot PAE kernels) ---
CONFIG_MVIAC7=y
CONFIG_X86_GENERIC=n
CONFIG_HIGHMEM4G=y
CONFIG_X86_PAE=n
CONFIG_X86_E_POWERSAVER=y

# --- OLPC platform + DCON (the XO display controller; BROKEN after 5.18) ---
CONFIG_OLPC=y
CONFIG_OLPC_XO15_SCI=y
# viafb and the DCON talk over I2C; =m here would force them to modules
CONFIG_I2C=y
CONFIG_I2C_ALGOBIT=y
CONFIG_MFD_CS5535=y
CONFIG_GPIO_CS5535=y
CONFIG_STAGING=y
CONFIG_FB=y
CONFIG_FB_VIA=y
CONFIG_FB_OLPC_DCON=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_DRM_SIMPLEDRM=n
CONFIG_POWER_SUPPLY=y
CONFIG_BATTERY_OLPC=y

# --- Built-in: what is needed to mount / without an initramfs ---
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PCI=y
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_FAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
# VX855 has UHCI + EHCI (not OHCI); built in so a USB stick can be the root
CONFIG_USB=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_UHCI_HCD=y
CONFIG_USB_STORAGE=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y

# --- Keyboard + touchpad ---
CONFIG_SERIO_I8042=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_MOUSE_PS2=y
CONFIG_MOUSE_PS2_OLPC=y
CONFIG_INPUT_EVDEV=y

# --- WiFi: Marvell Libertas 88W8686 on SDIO ---
CONFIG_CFG80211=m
CONFIG_LIBERTAS=m
CONFIG_LIBERTAS_SDIO=m

# --- Sound: VX855 HDA + Conexant codec ---
CONFIG_SND_HDA_INTEL=m
CONFIG_SND_HDA_CODEC_CONEXANT=m

# --- RAM: compressed swap ---
CONFIG_ZSMALLOC=y
CONFIG_ZRAM=m
CONFIG_CRYPTO_LZ4=m

